@page "/recursos"
@using Microsoft.EntityFrameworkCore
@using LinkVault_Proyecto.Models
@using LinkVault_Proyecto.Data
@inject ApplicationDbContext DB
@rendermode InteractiveServer

<PageTitle>Mis Recursos</PageTitle>

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h3>🚀 Mi Bóveda de Enlaces</h3>
        <button class="btn btn-success" @onclick="AbrirModal">➕ Nuevo Recurso</button>
    </div>

    <div>
        <div class="input-group mb-3">
            <span class="input-group-text">🔍 Buscar</span>
            <input type="text" class="form-control" placeholder="Escribe para filtrar por título o categoría..." @bind="textoBusqueda" @bind:event="oninput" />
        </div>
    </div>

    @if (recursos == null)
    {
        <div class="alert alert-info">Consultando Oracle XEPDB1...</div>
    }
    else if (!recursos.Any())
    {
        <div class="alert alert-warning">No hay enlaces registrados aún.</div>
    }
    else
    {
        <div class="row">
            @foreach (var item in recursosFiltrados) 
            {
                <div class="col-md-4 mb-3">
                    <div class="card shadow-sm h-100">
                        <div class="card-body">
                            <h5 class="card-title">@item.Titulo</h5>
                            <h6 class="card-subtitle mb-2 text-muted">
                                @(item.Categoria?.Nombre ?? "Sin Categoría")
                            </h6>
                            <div class="d-flex justify-content-between">
                                <a href="@item.Url" target="_blank" class="btn btn-outline-primary btn-sm">Visitar</a>
                                <div>
                                    <button class="btn btn-outline-warning btn-sm" @onclick="() => PrepararEdicion(item)">✏️</button>
                                    <button class="btn btn-outline-danger btn-sm" @onclick="() => EliminarRecurso(item.Id)">🗑️</button>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@if (mostrarModal)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Agregar Nuevo Recurso</h5>
                    <button type="button" class="btn-close" @onclick="CerrarModal"></button>
                </div>
                <div class="modal-body">
                    <EditForm Model="@nuevoRecurso" OnValidSubmit="GuardarRecurso">
                        <DataAnnotationsValidator />

                        <div class="mb-3">
                            <label class="form-label">Título</label>
                            <InputText class="form-control" @bind-Value="nuevoRecurso.Titulo" placeholder="Ej: Documentación Oracle" />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">URL (Link)</label>
                            <InputText class="form-control" @bind-Value="nuevoRecurso.Url" placeholder="https://..." />
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Categoría</label>
                            <InputSelect class="form-control" @bind-Value="nuevoRecurso.CategoriaId">
                                <option value="0">-- Seleccione una categoría --</option>
                                @if (categorias != null)
                                {
                                    @foreach (var cat in categorias)
                                    {
                                        <option value="@cat.Id">@cat.Nombre</option>
                                    }
                                }
                            </InputSelect>
                        </div>

                        <div class="modal-footer">
                            <button type="button" class="btn btn-secondary" @onclick="CerrarModal">Cancelar</button>
                            <button type="submit" class="btn btn-primary">Guardar en Bóveda</button>
                        </div>
                    </EditForm>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<Recurso>? recursos;
    private List<Categoria>? categorias;
    private Recurso nuevoRecurso = new();
    private bool mostrarModal = false;
    private String textoBusqueda = "";
    private List<Recurso> recursosFiltrados => string.IsNullOrWhiteSpace(textoBusqueda)
        ? recursos ?? new()
        : recursos?.Where(x =>
            x.Titulo.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase) ||
            (x.Categoria != null && x.Categoria.Nombre.Contains(textoBusqueda, StringComparison.OrdinalIgnoreCase))
          ).ToList() ?? new();

    protected override async Task OnInitializedAsync()
    {
        await CargarDatos();
    }

    private async Task CargarDatos()
    {
        try
        {
            recursos = await DB.Recursos.Include(r => r.Categoria).ToListAsync();
            categorias = await DB.Categorias.ToListAsync();
        }
        catch (Exception ex)
        {
            recursos = new List<Recurso>();
            Console.WriteLine($"Error: {ex.Message}");
        }
    }

    private async Task EliminarRecurso(int id)
    {
        var recursosAEliminar = await DB.Recursos.FindAsync(id); 

        if (recursosAEliminar != null)
        {
            DB.Recursos.Remove(recursosAEliminar);
            await DB.SaveChangesAsync();
            await CargarDatos(); // Refrescar la lista
        }
    }

    private void PrepararEdicion(Recurso item)
    {
        nuevoRecurso = item;
		mostrarModal = true;
    }

    private void AbrirModal()
    {
        nuevoRecurso = new Recurso();
        nuevoRecurso.Id = 0;        
        nuevoRecurso.CategoriaId = 0;
        mostrarModal = true;
    }

    private void CerrarModal() => mostrarModal = false;

    private async Task GuardarRecurso()
    {
        if (nuevoRecurso.CategoriaId == 0) return;

        try
        {
            if (nuevoRecurso.Id == 0)
            {
                DB.Recursos.Add(nuevoRecurso);
            }
            else
            {
              
                DB.Recursos.Update(nuevoRecurso);
            }

            await DB.SaveChangesAsync();

            mostrarModal = false; 
            await CargarDatos(); 

            nuevoRecurso = new Recurso { CategoriaId = 0 };
        }
        catch (DbUpdateException ex)
        {
            Console.WriteLine("Error: El ID ya existe o hay un problema de duplicidad.");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error general: {ex.Message}");
        }
    }
}